{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "brand/**",
              "components/cards/**",
              "components/navigation/**",
              "components/primitives/**",
              "components/reader/**",
              "components/security/**",
              "components/surfaces/**",
              "prototype/**",
              "screens/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Han Serif SC|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Source Han Serif SC, Noto Sans SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:book|onPress|key|ref|className|style|children)$/]",
        "message": "<BookListRow> doesn't accept that prop. Declared props: book, onPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|size|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, disabled, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:t|setT|key|ref|className|style|children)$/]",
        "message": "<DisplayPanel> doesn't accept that prop. Declared props: t, setT."
      },
      {
        "selector": "JSXOpeningElement[name.name='DockFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:chapterIndex|chapterCount|progress|activeAction|onAction|onPrevChapter|onNextChapter|sheetOpen|actions|labels|key|ref|className|style|children)$/]",
        "message": "<DockFooter> doesn't accept that prop. Declared props: chapterIndex, chapterCount, progress, activeAction, onAction, onPrevChapter, onNextChapter, sheetOpen, actions, labels."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightPen'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|color|label|key|ref|className|style|children)$/]",
        "message": "<HighlightPen> doesn't accept that prop. Declared props: id, color, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|weight|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, weight, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:regular|thin|light|bold|fill|duotone)$/]",
        "message": "<Icon> weight must be one of 'regular' | 'thin' | 'light' | 'bold' | 'fill' | 'duotone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InBookSearch'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onClose|matchIndex|matchCount|onPrevMatch|onNextMatch|style|key|ref|className|style|children)$/]",
        "message": "<InBookSearch> doesn't accept that prop. Declared props: value, onChange, onClose, matchIndex, matchCount, onPrevMatch, onNextMatch, style."
      },
